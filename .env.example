# ──────────────────────────────────────────────────────────────
# LLM Provider Configuration
# ──────────────────────────────────────────────────────────────
#
# RECOMMENDED (FREE): Google Gemini 1.5 Flash
#   1. Visit: https://aistudio.google.com/apikey
#   2. Sign in with a Google account (no billing required)
#   3. Click "Create API Key" → paste it below
#   Free limits: 1,500 requests/day, 1M tokens/minute
#
GEMINI_API_KEY=
PROJECT_HEALTH_LLM_PROVIDER=gemini
PROJECT_HEALTH_LLM_MODEL=gemini-1.5-flash

# ALTERNATIVE: OpenAI (requires billing)
OPENAI_API_KEY=

# ALTERNATIVE: Anthropic Claude (requires billing)
ANTHROPIC_API_KEY=

# Default SQLite database path.
PROJECT_HEALTH_DB=storage/project_health.sqlite
